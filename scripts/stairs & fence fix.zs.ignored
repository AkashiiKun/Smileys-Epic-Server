import crafttweaker.api.ingredient.IIngredient;
import crafttweaker.api.item.IItemStack;
import crafttweaker.api.item.ItemDefinition;
import crafttweaker.api.recipe.MirrorAxis;
import crafttweaker.api.recipe.type.Recipe;
import crafttweaker.api.recipe.type.ShapedRecipe;
import crafttweaker.api.tag.type.KnownTag;
import crafttweaker.api.world.Container;

function getRecipe(type as string, material as IIngredient, material2 as IIngredient) as IIngredient[][] {
    if type == "stairs" {
        return [
            [material],
            [material, material],
            [material, material, material]
        ];
    } else if type == "fence" {
        return [
            [material, material2, material],
            [material, material2, material]
        ];
    }
}

function fixRecipes(type as string, tag as KnownTag<ItemDefinition>, quantity as int) as void {
    for item in tag.elements {
        val itemIngredient = item.defaultInstance;

        val newRecipes = new stdlib.List<IIngredient[][]>();
        for r in craftingTable.getRecipesByOutput(itemIngredient) {
            if (r.value.ingredients.length == 6) {
                newRecipes.add(getRecipe(type, r.value.ingredients[0], r.value.ingredients[1]));
                break;
            }
        }

        craftingTable.remove(itemIngredient);

        for ingredients in newRecipes {
            craftingTable.addShapedMirrored("autogenerated_increased_quantity_" + itemIngredient.registryName.namespace + itemIngredient.registryName.path, MirrorAxis.HORIZONTAL, itemIngredient * quantity, ingredients);
        }
    }
}

fixRecipes("stairs", <tag:item:minecraft:stairs>, 8);
fixRecipes("fence", <tag:item:c:fences>, 6);
    

stoneCutter.remove(<item:copycats:copycat_stairs>);
stoneCutter.addRecipe("increased_quantity_copycat_stairs", <item:copycats:copycat_stairs> * 2, <tag:item:c:ingots/zinc>);

stoneCutter.remove(<item:copycats:copycat_vertical_stairs>);
stoneCutter.addRecipe("increased_quantity_copycat_vertical_stairs", <item:copycats:copycat_vertical_stairs> * 2, <tag:item:c:ingots/zinc>);

stoneCutter.remove(<item:copycats:copycat_fence>);
stoneCutter.addRecipe("increased_quantity_copycat_fence", <item:copycats:copycat_fence> * 2, <tag:item:c:ingots/zinc>);